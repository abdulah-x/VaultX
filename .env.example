# Root-level environment file, read by docker-compose.yml's variable
# substitution (${VAR}) when building the backend/frontend services.
#
# This is DISTINCT from backend/.env.example — some values (Google OAuth,
# GEMINI_API_KEY, REDIS_PASSWORD) must exist in BOTH the root .env and
# backend/.env, or an unset root var can substitute in as an empty string
# and silently shadow the real value from the mounted backend/.env.

# Google OAuth (used by both backend and frontend build args)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini (LLM Portfolio Advisor) — must match backend/.env's value
GEMINI_API_KEY=

# Redis password (defaults to changeme_dev_redis_password if unset — override for anything beyond local dev)
REDIS_PASSWORD=

# PostgreSQL credentials. docker-compose falls back to these dev defaults if
# unset (crypto_user / crypto_password / crypto_portfolio), so local dev works
# out of the box — but set real values here for anything beyond local dev, since
# they're what the DB is initialized with and what the backend/stream-writer
# connect with. Keep DATABASE_URL in backend/.env in sync if you override them.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Runtime behaviour ──────────────────────────────────────────────────────

# FastAPI debug mode. Sends exception detail to clients, so it defaults to false
# in docker-compose. Set true for local development only.
DEBUG=false

# uvicorn autoreload. Development only: the reloader watches the bind-mounted
# ./backend directory, so any file write there restarts the API and drops
# in-flight requests.
RELOAD=false

# Number of uvicorn worker processes.
WEB_CONCURRENCY=2

# ── Frontend ───────────────────────────────────────────────────────────────

# The API URL the END USER'S BROWSER will call.
#
# Next.js inlines NEXT_PUBLIC_* into the client bundle AT BUILD TIME, so this is
# a build input, not a runtime setting: changing it requires
# `docker compose build frontend`, not just a restart. Leaving it at localhost
# works only when the browser runs on the same machine as the stack — deployed
# elsewhere, every visitor's browser would call its own localhost.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Public origin of the frontend, used to build links in emails.
FRONTEND_URL=http://localhost:3100

# CORS allow-list for the API. JSON array.
ALLOWED_ORIGINS=["http://localhost:3100", "http://127.0.0.1:3100"]
